const primaDominical = async (idEmpleado) => {
    try{
        console.log(idEmpleado);
        const datosEmpleado = await Empleado.findById(idEmpleado);
        
        const pagoHora = datosEmpleado.pago;
        const pagoDiario = pagoHora * 9.6;
        const primaDominical = pagoDiario * 0.25;
