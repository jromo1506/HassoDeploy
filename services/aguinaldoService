const horasTrabajadasController = require('../controllers/horasTrabajadasController')
const HorasTrabajadas = require('../models/HorasTrabajadas');
const Empleado = require('../models/Empleado');


const calcularAguinaldo = async(idEmpleado,anio) =>{
    try{
        const horasTrabajadas = await obtenerHorasTrabajadas(idEmpleado,anio);
        const empleado = await obtenerEmpleado(idEmpleado);
        console.log(horasTrabajadas);
     
        const pagoHora = empleado.pago;
        const diasTrabajados = horasTrabajadas / 9.6; // Asumiendo 9.6 horas/día
        const salarioDiario = pagoHora * 9.6;
        const aguinaldo = (diasTrabajados / 365) * (15 * salarioDiario);

        const aguinaldoObj = {
            pagoHora,
            diasTrabajados,
            salarioDiario,
            aguinaldo,
        };
      
        console.log(aguinaldoObj,"Aguinaldo objeto");

        return aguinaldoObj;

    }
    catch(error){
        console.error("Error al obtener las horas regulares:", error);
    }

}


const obtenerHorasTrabajadas = async(idEmpleado,year) => {
    try {
        // Calcular el rango de fechas para el año ingresado
        const fechaInicio = new Date(`${year}-01-01T00:00:00Z`);
        const fechaFin = new Date(`${year}-12-31T23:59:59Z`);

        // Consultar las horas regulares del empleado dentro del rango de fechas
        const horasRegulares = await HorasTrabajadas.aggregate([
            {
                $match: {
                    idEmpleado: idEmpleado,
                    sonHorasExtra: false, // Solo horas regulares
                    fecha: { $gte: fechaInicio, $lte: fechaFin }
                }
            },
            {
                $group: {
                    _id: null, // Agrupar todo en un solo resultado
                    totalHoras: { $sum: "$horasTrabajadas" } // Sumar las horas trabajadas
                }
            }
        ]);

        // Si no hay registros, devolver 0
        if (horasRegulares.length === 0) return 0;

        return horasRegulares[0].totalHoras;
    } catch (error) {
        console.error("Error al obtener las horas regulares:", error);
        throw new Error("No se pudieron calcular las horas regulares");
    }
}

